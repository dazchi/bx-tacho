# BX Tacho firmware defaults (ESP32-C3-WROOM-02, 4 MB flash)
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition table with an extra "fctry" NVS partition for production data
# (VBAT calibration) that `cfg reset` and NVS recovery never erase
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Updates over BLE: a new firmware that resets before confirming itself
# (main.c) is replaced by the previous one at the next boot
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Console and flashing over the native USB Serial/JTAG (IO18/IO19).
# UART0 TX (IO21) is RPM_IR_LED, so keep the console off UART0.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# 1 kHz tick: the load sensor is sampled every 1 ms while a top is loaded
CONFIG_FREERTOS_HZ=1000

# The load LED flash at each RPM edge runs in interrupts (GPIO, then a GPTimer
# alarm) that may fire while the flash cache is off, e.g. during an NVS write
CONFIG_ADC_ONESHOT_CTRL_FUNC_IN_IRAM=y
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y
CONFIG_GPTIMER_ISR_CACHE_SAFE=y

# Automatic light sleep between polls (HANDOVER.md 6.5)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# The ESP32-C3's USB console stops working in light sleep. Block light sleep
# while a USB host is actually talking to the chip (SOF packets), also on a
# data-only cable without VBUS; without a host it is released within ~3 ms.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# VUSB_DET is driven by the R2/R5 divider; internal pulls would load it
# during deep sleep.
CONFIG_ESP_SLEEP_GPIO_ENABLE_INTERNAL_RESISTORS=n

# Battle Pass emulation (main/bbp.c): BLE peripheral on NimBLE, one connection
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# BLE alongside automatic light sleep. The board has no 32 kHz crystal, so the
# main crystal clocks the controller and stays powered in light sleep.
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
CONFIG_ESP_PHY_MAC_BB_PD=y

# NimBLE logs two INFO lines per notification (26 per launch); keep warnings
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
